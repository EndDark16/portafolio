# ------------------------------------------------------------------
# Next.js portfolio — files that are generated, local or sensitive.
# NOTE: public/ (including cv_cond_esp.pdf and cv_cond.pdf) is tracked.
# ------------------------------------------------------------------

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/

# Production build
/build

# Testing
/coverage

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Environment variables (never commit secrets)
.env
.env*.local
.env.*
!.env.example

# Vercel
.vercel

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Local AI tooling (never committed)
.claude/
CLAUDE.md

# Misc
*.pem
